generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  WASHER
  DRYER
  AIRFRYER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CoinReason {
  BOOKING_CHARGE
  TOPUP
  ADJUSTMENT
  REFUND
  CLEANING_REWARD
  CLEANING_REVERSAL
}

enum CleaningTaskType {
  KITCHEN_D2
  KITCHEN_D7
  TRASH_D7
}

enum CleaningTaskStatus {
  ASSIGNED
  DONE_PENDING_AUDIT
  APPROVED
  REJECTED
  MISSED
}

enum CleaningAssignmentSource {
  SYSTEM
  MANAGER
  SELF
}

enum CleaningAvailabilityType {
  AVAILABLE
  UNAVAILABLE
  PREFERRED
}

enum CleaningAuditDecision {
  APPROVE
  REJECT
}

enum SupportConversationStatus {
  OPEN
  CLOSED
}

enum SupportMessageSenderRole {
  RESIDENT
  MANAGER
  OWNER
}

enum SupportViewerRole {
  RESIDENT
  STAFF
}

model Branch {
  id        String     @id
  name      String
  resources Resource[]
}

model Resource {
  id            String       @id @default(cuid())
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  type          ResourceType
  label         String
  calendarId    String?
  slotMinutes   Int          @default(60)
  bufferMinutes Int          @default(10)
  active        Boolean      @default(true)
  bookings      Booking[]

  @@index([branchId, active])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  resourceId  String
  resource    Resource      @relation(fields: [resourceId], references: [id])
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(CONFIRMED)
  gcalEventId String?
  priceCoins  Int
  createdAt   DateTime      @default(now())

  @@index([resourceId, startAt])
  @@index([resourceId, endAt])
  @@index([resourceId, startAt, endAt])
}

model CoinLedger {
  id        String     @id @default(cuid())
  userId    String
  delta     Int
  reason    CoinReason
  refType   String?
  refId     String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
}

model CleaningAvailability {
  id        String                  @id @default(cuid())
  userEmail String
  branchId  String
  floor     Int?
  date      DateTime
  type      CleaningAvailabilityType
  note      String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([userEmail, date])
  @@index([branchId, date])
}

model CleaningTask {
  id               String             @id @default(cuid())
  userEmail        String
  userName         String?
  branchId         String
  floor            Int?
  type             CleaningTaskType
  scheduledDate    DateTime
  calendarId       String?
  calendarEventId  String?
  status           CleaningTaskStatus @default(ASSIGNED)
  rewardCoins      Int
  isSelfAssigned   Boolean            @default(false)
  assignmentSource CleaningAssignmentSource @default(MANAGER)
  completedAt      DateTime?
  completionNote   String?
  completionPhoto  String?
  auditorNote      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  audits           CleaningAudit[]

  @@index([userEmail, scheduledDate])
  @@index([branchId, scheduledDate])
  @@index([type, scheduledDate])
}

model CleaningAudit {
  id         String               @id @default(cuid())
  taskId      String
  task        CleaningTask        @relation(fields: [taskId], references: [id])
  reviewer    String
  decision    CleaningAuditDecision
  note        String?
  createdAt   DateTime            @default(now())

  @@index([taskId, createdAt])
}

model SupportConversation {
  id              String                    @id @default(cuid())
  residentEmail   String                    @unique
  residentName    String?
  status          SupportConversationStatus @default(OPEN)
  lastMessageAt   DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  messages        SupportMessage[]
  readStates      SupportReadState[]

  @@index([status, lastMessageAt])
}

model SupportMessage {
  id               String                   @id @default(cuid())
  conversationId   String
  conversation     SupportConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderEmail      String
  senderName       String?
  senderRole       SupportMessageSenderRole
  body             String                   @db.Text
  pagePath         String?
  createdAt        DateTime                 @default(now())

  @@index([conversationId, createdAt])
  @@index([senderEmail, createdAt])
}

model SupportReadState {
  id               String            @id @default(cuid())
  conversationId   String
  conversation     SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  viewerEmail      String
  viewerRole       SupportViewerRole
  lastReadAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([conversationId, viewerEmail, viewerRole])
  @@index([viewerEmail, viewerRole, updatedAt])
}
model GroupMessage {
  id               String                   @id @default(cuid())
  groupId          String                   // e.g., "ROOM_D7_1.2", "FLOOR_D7_1", "BRANCH_D7"
  senderEmail      String
  senderName       String?
  senderRole       SupportMessageSenderRole
  isAnonymous      Boolean                  @default(false)
  body             String                   @db.Text
  createdAt        DateTime                 @default(now())

  @@index([groupId, createdAt])
}

model GroupReadState {
  id               String            @id @default(cuid())
  groupId          String
  viewerEmail      String
  lastReadAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([groupId, viewerEmail])
}

model CleaningOptOut {
  id            String    @id @default(cuid())
  userEmail     String
  branchId      String
  month         String    // "YYYY-MM"
  paymentMethod String    // "VND" | "COINS"
  chargedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userEmail, month])
  @@index([branchId, month])
}

enum StayBookingStatus {
  CONFIRMED
  CANCELLED
}

model StayBooking {
  id          String            @id @default(cuid())
  branchId    String
  roomCode    String
  bedNumber   Int
  guestName   String
  guestEmail  String
  guestPhone  String?
  checkIn     DateTime
  checkOut    DateTime
  nights      Int
  notes       String?
  status      StayBookingStatus @default(CONFIRMED)
  source      String            @default("DIRECT_WEB")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([branchId, checkIn, checkOut])
  @@index([branchId, bedNumber, checkIn, checkOut])
  @@index([guestEmail, createdAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  email     String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.Text
  auth      String
  createdAt DateTime @default(now())

  @@index([email])
}
