generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  WASHER
  DRYER
  AIRFRYER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CoinReason {
  BOOKING_CHARGE
  TOPUP
  ADJUSTMENT
  REFUND
  CLEANING_REWARD
  CLEANING_REVERSAL
  CLEANING_SWAP_DEBIT
  CLEANING_SWAP_CREDIT
}

enum CleaningSwapRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum CleaningTaskType {
  KITCHEN_D2
  KITCHEN_D7
  TRASH_D7
}

enum CleaningTaskStatus {
  ASSIGNED
  DONE_PENDING_AUDIT
  APPROVED
  REJECTED
  MISSED
}

enum CleaningAssignmentSource {
  SYSTEM
  MANAGER
  SELF
}

enum CleaningAvailabilityType {
  AVAILABLE
  UNAVAILABLE
  PREFERRED
}

enum CleaningAuditDecision {
  APPROVE
  REJECT
}

enum CleaningScheduleCorrectionAction {
  REASSIGN
  ASSIGN_OVERRIDE
  REMOVE
  REPLACE_SYSTEM
}

enum SupportConversationStatus {
  OPEN
  CLOSED
}

enum SupportMessageSenderRole {
  RESIDENT
  MANAGER
  OWNER
  ASSISTANT
}

enum SupportViewerRole {
  RESIDENT
  STAFF
}

model Branch {
  id        String     @id
  name      String
  resources Resource[]
}

model Resource {
  id            String       @id @default(cuid())
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  type          ResourceType
  label         String
  calendarId    String?
  slotMinutes   Int          @default(60)
  bufferMinutes Int          @default(10)
  active        Boolean      @default(true)
  bookings      Booking[]

  @@index([branchId, active])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  resourceId  String
  resource    Resource      @relation(fields: [resourceId], references: [id])
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(CONFIRMED)
  gcalEventId String?
  priceCoins  Int
  createdAt   DateTime      @default(now())

  @@index([resourceId, startAt])
  @@index([resourceId, endAt])
  @@index([resourceId, startAt, endAt])
}

model CoinLedger {
  id        String     @id @default(cuid())
  userId    String
  delta     Int
  reason    CoinReason
  refType   String?
  refId     String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
}

model ActionLog {
  id          String   @id @default(cuid())
  actorEmail  String?
  actorName   String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([actorEmail, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model AiUsageEvent {
  id                  String   @id @default(cuid())
  provider            String
  model               String
  feature             String
  actorEmail          String?
  promptTokens        Int      @default(0)
  outputTokens        Int      @default(0)
  thinkingTokens      Int      @default(0)
  cachedTokens        Int      @default(0)
  totalTokens         Int      @default(0)
  estimatedCostMicros Int      @default(0)
  pricingVersion      String
  status              String   @default("SUCCESS")
  latencyMs           Int?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([model, createdAt])
}

model BedOccupancySnapshot {
  id              String   @id @default(cuid())
  month           String
  branchId        String
  snapshotDate    DateTime
  totalBeds       Int
  occupiedBeds    Int
  availableBeds   Int
  unassignedUsers Int      @default(0)
  capturedAt      DateTime @default(now())

  @@unique([month, branchId])
  @@index([snapshotDate])
  @@index([branchId, snapshotDate])
}

model CleaningAvailability {
  id        String                  @id @default(cuid())
  userEmail String
  branchId  String
  floor     Int?
  date      DateTime
  type      CleaningAvailabilityType
  note      String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([userEmail, date])
  @@index([branchId, date])
}

model CleaningTask {
  id               String             @id @default(cuid())
  userEmail        String
  userName         String?
  assignedByEmail  String?
  assignedByName   String?
  branchId         String
  floor            Int?
  type             CleaningTaskType
  scheduledDate    DateTime
  /// Slot dedup key: "{type}|{YYYY-MM-DD}|{floor or empty}" — unique per calendar slot across all processes/machines.
  slotKey          String             @default("")
  calendarId       String?
  calendarEventId  String?
  status           CleaningTaskStatus @default(ASSIGNED)
  rewardCoins      Int
  isSelfAssigned   Boolean            @default(false)
  assignmentSource CleaningAssignmentSource?
  completedAt      DateTime?
  completionNote   String?
  completionPhoto  String?
  auditorNote      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  audits           CleaningAudit[]

  @@unique([slotKey], map: "CleaningTask_slotKey_key")
  @@index([userEmail, scheduledDate])
  @@index([branchId, scheduledDate])
  @@index([type, scheduledDate])
}

model CleaningAudit {
  id         String               @id @default(cuid())
  taskId      String
  task        CleaningTask        @relation(fields: [taskId], references: [id])
  reviewer    String
  decision    CleaningAuditDecision
  note        String?
  createdAt   DateTime            @default(now())

  @@index([taskId, createdAt])
}

/// Reusable checkbox options for why staff corrected auto-schedule (seeded + staff-added).
model CleaningScheduleCorrectionReason {
  id        String   @id @default(cuid())
  /// Stable key for seeded reasons, e.g. "overlap"
  code      String?  @unique
  labelVi   String
  labelEn   String?
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(100)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    CleaningScheduleCorrectionReasonLink[]

  @@index([isActive, sortOrder])
}

/// One human correction of an auto/manual schedule assignment (RL feedback signal).
model CleaningScheduleCorrection {
  id                String                            @id @default(cuid())
  action            CleaningScheduleCorrectionAction
  taskId            String?
  slotKey           String?
  taskType          CleaningTaskType
  scheduledDate     DateTime
  floor             Int?
  previousUserEmail String?
  previousUserName  String?
  previousSource    CleaningAssignmentSource?
  newUserEmail      String?
  actorEmail        String
  actorName         String?
  customNote        String?                           @db.Text
  createdAt         DateTime                          @default(now())
  reasons           CleaningScheduleCorrectionReasonLink[]

  @@index([createdAt])
  @@index([taskType, scheduledDate])
  @@index([actorEmail, createdAt])
  @@index([previousSource, createdAt])
}

model CleaningScheduleCorrectionReasonLink {
  correctionId String
  reasonId     String
  correction   CleaningScheduleCorrection       @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  reason       CleaningScheduleCorrectionReason @relation(fields: [reasonId], references: [id], onDelete: Cascade)

  @@id([correctionId, reasonId])
  @@index([reasonId])
}

model SupportConversation {
  id                       String                    @id @default(cuid())
  residentEmail            String                    @unique
  residentName             String?
  status                   SupportConversationStatus @default(OPEN)
  lastMessageAt            DateTime                  @default(now())
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  /// Callback details the AI may collect for staff (phone, Facebook link/username, or free-text e.g. Zalo).
  residentContactPhone     String?                   @db.VarChar(48)
  residentContactFacebook  String?                   @db.VarChar(191)
  residentContactOther     String?                   @db.VarChar(255)
  messages                 SupportMessage[]
  readStates               SupportReadState[]

  @@index([status, lastMessageAt])
}

model SupportMessage {
  id               String                   @id @default(cuid())
  conversationId   String
  conversation     SupportConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderEmail      String
  senderName       String?
  senderRole       SupportMessageSenderRole
  body             String                   @db.Text
  pagePath         String?
  createdAt        DateTime                 @default(now())

  @@index([conversationId, createdAt])
  @@index([senderEmail, createdAt])
}

model SupportReadState {
  id               String            @id @default(cuid())
  conversationId   String
  conversation     SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  viewerEmail      String
  viewerRole       SupportViewerRole
  lastReadAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([conversationId, viewerEmail, viewerRole])
  @@index([viewerEmail, viewerRole, updatedAt])
}
model GroupMessage {
  id               String                   @id @default(cuid())
  groupId          String                   // e.g., "ROOM_D7_1.2", "FLOOR_D7_1", "BRANCH_D7"
  senderEmail      String
  senderName       String?
  senderRole       SupportMessageSenderRole
  isAnonymous      Boolean                  @default(false)
  body             String                   @db.Text
  createdAt        DateTime                 @default(now())

  @@index([groupId, createdAt])
}

model GroupReadState {
  id               String            @id @default(cuid())
  groupId          String
  viewerEmail      String
  lastReadAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([groupId, viewerEmail])
}

model CleaningOptOut {
  id            String    @id @default(cuid())
  userEmail     String
  branchId      String
  month         String    // "YYYY-MM"
  paymentMethod String    // "VND" | "COINS"
  chargedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userEmail, month])
  @@index([branchId, month])
}

model CleaningContractOptOut {
  id            String   @id @default(cuid())
  userEmail      String
  branchId       String
  contractCode   String   @unique
  cleaningFeeVnd Int      @default(100000)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userEmail])
  @@index([branchId])
}

enum StayBookingStatus {
  CONFIRMED
  CANCELLED
}

model StayBooking {
  id          String            @id @default(cuid())
  branchId    String
  roomCode    String
  bedNumber   Int
  guestName   String
  guestEmail  String
  guestPhone  String?
  checkIn     DateTime
  checkOut    DateTime
  nights      Int
  notes       String?
  status      StayBookingStatus @default(CONFIRMED)
  source      String            @default("DIRECT_WEB")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([branchId, checkIn, checkOut])
  @@index([branchId, bedNumber, checkIn, checkOut])
  @@index([guestEmail, createdAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  email     String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.Text
  auth      String
  createdAt DateTime @default(now())

  @@index([email])
}

/// Manager-recorded gate / curb parking charges; unpaid rows roll into the next monthly bill until rent clears them.
model GateParkingTicket {
  id            String    @id @default(cuid())
  residentEmail String
  periodMonth   String
  amountVnd     Int
  /// When the gate parking session started (local business time is interpreted when saving from ISO).
  sessionStartAt DateTime?
  /// How long the vehicle was parked (hours); shown on the ticket and for records.
  durationHours  Float?
  note          String?   @db.Text
  createdBy     String
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([residentEmail, periodMonth])
  @@index([residentEmail, paidAt])
}

model MonthlyRentStatus {
  id        Int      @id @default(autoincrement())
  email     String
  month     String
  isPaid    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String   @default("")

  /// Resident opt-in: apply Cozoro Coins toward this month’s bill (preview until redeem; cap 10% of full bill, tier rate).
  applyCoinsTowardRent Boolean @default(false)

  /// After resident confirms coin exchange: coins deducted from sheet; bill uses these amounts until paid.
  rentCoinRedeemCoins    Int?
  rentCoinRedeemValueVnd Int?
  rentCoinRedeemAt       DateTime?

  /// When a rent receipt was recorded via pay-rent (or manual backfill)
  paidRecordedAt DateTime?

  /// Portion of the bill attributable to rent + surcharges − discounts (excludes parking, gate, laundry, fines)
  snapshotRentSubtotalVnd Int?
  snapshotParkingVnd     Int?
  snapshotGateParkingVnd Int?
  snapshotLaundryVnd      Int?
  snapshotFinesVnd       Int?
  snapshotFinalTotalVnd   Int?
  snapshotCoinValueVnd    Int?

  @@unique([email, month])
  @@index([email])
}

/// Manager-reviewed multi-month (prepaid) package amount for a resident billing month; drives portal total + optional notifications.
model PrepaidPackageBilling {
  id                     String    @id @default(cuid())
  residentEmail          String
  billingMonth           String
  /// Engine snapshot when manager last saved (JSON)
  calculatedSnapshot     Json
  /// Owner-only line overrides (package net, laundry, gate, fines) merged over the engine for display; see `prepaid-breakdown-overrides.ts`
  breakdownOverrides     Json?
  /// Final total shown to resident after confirm (₫)
  managerPackageTotalVnd Int
  managerNote            String?   @db.Text
  confirmed              Boolean   @default(false)
  confirmedAt            DateTime?
  confirmedBy            String?
  lastAppNotifyAt        DateTime?
  lastEmailNotifyAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([residentEmail, billingMonth])
  @@index([residentEmail, confirmed])
}

// ── Unified Pricing ──────────────────────────────────────────────────────────

// Per-branch configurable fees set by owner
model BranchPricingSettings {
  id                   Int      @id @default(autoincrement())
  branchId             String   @unique // "D2" | "D7"
  cleaningOptOutFeeVnd Int      @default(100000) // monthly fee to opt out of cleaning duty
  parkingFeeVnd        Int      @default(0)      // default monthly parking fee for this branch
  updatedBy            String
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

// Per-bed parking fee override (overrides branch default)
model BedParkingFeeOverride {
  id           Int      @id @default(autoincrement())
  branchId     String
  bedNumber    Int
  parkingFeeVnd Int
  updatedBy    String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([branchId, bedNumber])
  @@index([branchId])
}

/// Named motorbike parking rates per branch (registration + resident choice). If none exist, branch `parkingFeeVnd` is used as a single implicit tier.
model ParkingPricingTier {
  id        String   @id @default(cuid())
  branchId  String // "D2" | "D7"
  labelEn   String   @db.VarChar(200)
  labelVi   String   @db.VarChar(200)
  feeVnd    Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  updatedBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([branchId, active, sortOrder])
}

model BedPriceOverride {
  id           Int      @id @default(autoincrement())
  branchId     String   // "D2" | "D7"
  bedNumber    Int
  termType     String   // "long_term" | "short_term"
  monthlyPrice Int?     // long_term: VND/month (null = use sheet value)
  deposit      Int?     // long_term: VND deposit (null = use sheet value)
  nightlyPrice Int?     // short_term: VND/night (null = use default)
  updatedBy    String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([branchId, bedNumber, termType])
  @@index([branchId, termType])
}

model PricingDiscount {
  id             String   @id
  termType       String   // "long_term" | "short_term"
  label          String
  description    String   @db.Text
  amountVnd      Int?     // long_term: flat monthly deduction in VND
  percentOff     Int?     // short_term: percent off (0-100)
  minNights      Int?     // short_term: minimum nights to qualify
  durationMonths Int?     // long_term: months discount applies (null = entire contract)
  eligibility    Json     // long_term: array of EligibilityRule; short_term: []
  enabled        Boolean  @default(true)
  createdBy      String
  updatedBy      String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([termType, enabled])
}

/// Bilingual resident-facing how-to sections (laundry, cleaning, etc.); managers edit in Settings.
enum ResidentGuideContentType {
  STEPS
  VIDEO
}

/// HOWTO = portal how-to (laundry, cleaning). CHECK_IN = arrival / check-in instructions.
enum ResidentGuideCategory {
  HOWTO
  CHECK_IN
}

/// Who should see this guide section.
enum ResidentGuideAudience {
  LONG_TERM
  SHORT_TERM
  BOTH
}

model ResidentGuideSection {
  id          String                   @id @default(cuid())
  /// Lowercase slug, unique (e.g. laundry, cleaning_schedule, check_in_short_term)
  slug        String                   @unique @db.VarChar(80)
  titleVi     String                   @db.VarChar(200)
  titleEn     String                   @db.VarChar(200)
  sortOrder   Int                      @default(0)
  contentType ResidentGuideContentType
  category    ResidentGuideCategory    @default(HOWTO)
  audience    ResidentGuideAudience    @default(BOTH)
  /// YouTube / Vimeo watch URL or direct .mp4 link for VIDEO mode
  videoUrl    String?                  @db.VarChar(2000)
  /// STEPS: [{ "bodyVi", "bodyEn", "imageUrl"? }]
  stepsJson   Json?
  updatedBy   String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([sortOrder])
  @@index([category, audience])
}

model CleaningSwapRequest {
  id                String                    @id @default(cuid())
  taskId            String
  requesterEmail    String
  requesterName     String?
  targetEmail       String
  targetName        String?
  offeredCoins      Int                       @default(0)
  status            CleaningSwapRequestStatus @default(PENDING)
  taskType          CleaningTaskType
  taskScheduledDate DateTime
  taskBranchId      String
  taskRewardCoins   Int
  respondedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([requesterEmail, status, createdAt])
  @@index([targetEmail, status, createdAt])
  @@index([taskId, status])
}

/// Marketing-site (www) AI chat leads — synced from cozorohome-www for staff follow-up.
enum WebLeadMessageRole {
  GUEST
  BOT
  STAFF
}

enum WebLeadConversationStatus {
  OPEN
  CLOSED
}

model WebLeadConversation {
  id              String                     @id @default(cuid())
  conversationKey String                     @unique
  guestName       String?
  phone           String?                    @db.VarChar(48)
  facebook        String?                    @db.VarChar(191)
  otherContact    String?                    @db.VarChar(255)
  preferredBranch String?                    @db.VarChar(8)
  stayMonths      Int?
  moveInHint      String?                    @db.VarChar(120)
  occupationHint  String?                    @db.VarChar(64)
  lastQuoteVnd    Int?
  summary         String?                    @db.Text
  status          WebLeadConversationStatus  @default(OPEN)
  lastMessageAt   DateTime                   @default(now())
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  messages        WebLeadMessage[]

  @@index([status, lastMessageAt])
  @@index([phone])
}

model WebLeadMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   WebLeadConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           WebLeadMessageRole
  body           String              @db.Text
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}
