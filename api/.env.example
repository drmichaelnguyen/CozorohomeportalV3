# API Configuration (this file lives in `api/` — the server loads `api/.env` even when Node is started from the repo root)
PORT=4000
COZORO_TIMEZONE="Asia/Ho_Chi_Minh"

# Google Integration (Sheets / Calendar OAuth — do NOT use for portal login)
GOOGLE_CLIENT_ID="your_sheets_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_sheets_oauth_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/integrations/google/oauth/callback"
GOOGLE_SPREADSHEET_ID="your_spreadsheet_id"

# Fridge drain / clean — one Google Calendar per branch (shared kitchen fridges). Paste each calendar’s ID from Google Calendar settings.
# GOOGLE_FRIDGE_DRAIN_CALENDAR_D2="xxxx@group.calendar.google.com"
# GOOGLE_FRIDGE_DRAIN_CALENDAR_D7="yyyy@group.calendar.google.com"
# Google Sign-In for portal login (separate OAuth Web Client — keep independent from above)
GOOGLE_LOGIN_CLIENT_ID="your_google_signin_client_id"

# Database
DATABASE_URL="mysql://user:pass@localhost:3306/dbname"

# Gemini (optional — manager Settings AI uses GEMINI_API_KEY if set)
# GEMINI_API_KEY=""

# Gemini — resident Cozoro Bee (Messages tab). Optional separate key; if unset, Cozoro Bee uses GEMINI_API_KEY.
# GEMINI_RESIDENT_PORTAL_AI_API_KEY=""
# RESIDENT_PORTAL_AI_DISABLED=1

# Append AI chat turns to api/data/ai-chat-training/*.jsonl (for training exports). Set to disable.
# AI_TRAINING_LOG_DISABLED=1

# Stripe (hostel guest bookings — same secret key as guest-booking-standalone)
# STRIPE_SECRET_KEY="sk_test_..."

# Other
IFTTT_WEBHOOK_KEY="your_key"
AIRFRYER_D7_IFTTT_EVENT="webhookairfryer"
MICROWAVE_D2_IFTTT_EVENT="microwaveD2"
# Cooker 1 / Cooker 2 ON/OFF webhooks use the same IFTTT JSON pattern as AC. Leave blank until events exist.
# COOKER_D7_1_IFTTT_ON_EVENT="cookerD7_1On"
# COOKER_D7_1_IFTTT_OFF_EVENT="cookerD7_1Off"
# COOKER_D7_2_IFTTT_ON_EVENT="cookerD7_2On"
# COOKER_D7_2_IFTTT_OFF_EVENT="cookerD7_2Off"
# COOKER_D2_1_IFTTT_ON_EVENT="cookerD2_1On"
# COOKER_D2_1_IFTTT_OFF_EVENT="cookerD2_1Off"
# COOKER_D2_2_IFTTT_ON_EVENT="cookerD2_2On"
# COOKER_D2_2_IFTTT_OFF_EVENT="cookerD2_2Off"
# COOKER_MAX_ON_MINUTES=90
# COOKER_LEFT_ON_FINE_VND=50000
GOOGLE_MICROWAVE_LOG_SPREADSHEET_ID="your_microwave_log_spreadsheet_id"
