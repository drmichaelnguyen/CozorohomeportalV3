# API Configuration
PORT=4000
COZORO_TIMEZONE="Asia/Ho_Chi_Minh"

# Google Integration (Sheets / Calendar OAuth — do NOT use for portal login)
GOOGLE_CLIENT_ID="your_sheets_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_sheets_oauth_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/integrations/google/oauth/callback"
GOOGLE_SPREADSHEET_ID="your_spreadsheet_id"

# Google Sign-In for portal login (separate OAuth Web Client — keep independent from above)
GOOGLE_LOGIN_CLIENT_ID="your_google_signin_client_id"

# Database
DATABASE_URL="mysql://user:pass@localhost:3306/dbname"

# Gemini (optional — manager Settings AI uses GEMINI_API_KEY if set)
# GEMINI_API_KEY=""

# Gemini — resident Cozoro AI in Messages tab (separate key from manager; gemini-2.5-flash)
# GEMINI_RESIDENT_PORTAL_AI_API_KEY=""
# RESIDENT_PORTAL_AI_DISABLED=1

# Append AI chat turns to api/data/ai-chat-training/*.jsonl (for training exports). Set to disable.
# AI_TRAINING_LOG_DISABLED=1

# Other
IFTTT_WEBHOOK_KEY="your_key"
AIRFRYER_D7_IFTTT_EVENT="webhookairfryer"
MICROWAVE_D2_IFTTT_EVENT="microwaveD2"
GOOGLE_MICROWAVE_LOG_SPREADSHEET_ID="your_microwave_log_spreadsheet_id"
